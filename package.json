{
  "name": "lastfm-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript playground and Ember visualization lab for the Last.fm API",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "imports": {
    "#app/*": "./app/*",
    "#cli/*": "./cli/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#shared/*": "./shared/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite",
    "sync": "node cli/sync.ts",
    "export": "node cli/export.ts",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "test:ci": "pnpm build:test && testem ci --port 0",
    "test": "pnpm build:test && pnpm test:ci",
    "lint:types": "tsc --noEmit --runExternalCode",
    "typecheck": "tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^3.0.6",
    "@glimmer/component": "^2.2.1",
    "decorator-transforms": "^2.4.0",
    "ember-source": "~7.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/runtime": "^7.29.10",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.6.10",
    "@glint/ember-tsc": "^1.14.3",
    "@glint/template": "^1.11.1",
    "@nullvoxpopuli/ember-vite": "1.3.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/qunit": "^2.19.14",
    "@typescript/native": "npm:typescript@^7.1.0-dev.20261103.1",
    "babel-plugin-debug-macros": "^2.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^9.2.5",
    "daisyui": "^5.7.50",
    "ember-content-mapper": "^0.3.2",
    "ember-eslint": "^1.0.0",
    "ember-qunit": "^9.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-ember": "^13.9.1",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "3.5.0",
    "qunit-theme-ember": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "testem": "3.17.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  }
}
